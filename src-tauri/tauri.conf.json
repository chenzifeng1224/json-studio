{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "JSON Studio",
  "version": "1.0.0",
  "identifier": "com.local.jsonstudio",
  "build": { "beforeDevCommand": "npm run dev", "devUrl": "http://localhost:1420", "beforeBuildCommand": "npm run build", "frontendDist": "../dist" },
  "app": { "windows": [{ "title": "JSON Studio · JSON 编辑器", "width": 1440, "height": 900, "minWidth": 980, "minHeight": 640 }], "security": { "csp": "default-src 'self'; img-src 'self' asset: data:; style-src 'self' 'unsafe-inline'; worker-src 'self' blob:; script-src 'self' 'unsafe-eval'" } },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "本地 JSON 编辑器与 S3 管理工具",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"]
  },
  "plugins": { "dialog": {}, "fs": { "requireLiteralLeadingDot": false } }
}